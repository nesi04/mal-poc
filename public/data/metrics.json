{
 "definitions": [
  {
   "id": "impression_click_visibility",
   "name": "Impression to Click Visibility",
   "category": "Visibility",
   "formula": "correlated clicks / controlled impressions x 100",
   "start": "Impression logged",
   "end": "Click logged with its impression_id",
   "note": "The red team clicks every controlled impression, so this measures Blue-side correlation, not CTR."
  },
  {
   "id": "click_landing_visibility",
   "name": "Click to Landing Visibility",
   "category": "Visibility",
   "formula": "correlated landing events / controlled clicks x 100",
   "start": "Click",
   "end": "Landing event logged",
   "note": "Journeys blocked inline before landing lower this figure; the breakdown separates blocks from telemetry loss."
  },
  {
   "id": "detection_coverage",
   "name": "Detection Coverage",
   "category": "Detection",
   "formula": "attack paths with the expected detection / total attack paths x 100",
   "start": "-",
   "end": "-",
   "note": "Benign controls are excluded from the denominator."
  },
  {
   "id": "ttd",
   "name": "Time to Detection (TTD)",
   "category": "Response speed",
   "formula": "detection timestamp - first redirect hop (attack event)",
   "start": "First redirect hop",
   "end": "Detection",
   "note": "Detection latency is SIMULATED per rule."
  },
  {
   "id": "ttt",
   "name": "Time to Triage (TTT)",
   "category": "Response speed",
   "formula": "triage start - alert creation",
   "start": "Alert created",
   "end": "Triage started",
   "note": "SOC timings are SIMULATED."
  },
  {
   "id": "ttc",
   "name": "Time to Containment (TTC)",
   "category": "Response speed",
   "formula": "containment effective - alert creation",
   "start": "Alert created",
   "end": "Containment effective",
   "note": "Failed containments are excluded from the statistics and reported separately."
  },
  {
   "id": "blocking_propagation",
   "name": "Blocking Propagation Time",
   "category": "Containment",
   "formula": "containment effective - containment requested",
   "start": "Block requested",
   "end": "Block effective",
   "note": "SIMULATED."
  },
  {
   "id": "containment_success",
   "name": "Containment Success Rate",
   "category": "Containment",
   "formula": "attack paths successfully contained / total attack paths x 100",
   "start": "-",
   "end": "-",
   "note": "Undetected paths count as not contained."
  },
  {
   "id": "redirect_inspection",
   "name": "Redirect Inspection Coverage",
   "category": "Visibility",
   "formula": "redirect hops logged / total redirect hops x 100",
   "start": "-",
   "end": "-",
   "note": ""
  },
  {
   "id": "false_positive",
   "name": "False Positive / Legitimate Destination Check",
   "category": "Safety / quality",
   "formula": "benign controls generating an incident / benign controls x 100",
   "start": "-",
   "end": "-",
   "note": "Only two benign controls exist, so the rate is illustrative."
  },
  {
   "id": "identity_protection",
   "name": "Identity Protection",
   "category": "Detection",
   "formula": "credential-simulation events detected / executed x 100",
   "start": "-",
   "end": "-",
   "note": "Synthetic test events only. No credential or secret is ever collected."
  },
  {
   "id": "evidence_completeness",
   "name": "Evidence Completeness",
   "category": "Safety / quality",
   "formula": "evidence items captured / evidence items expected x 100",
   "start": "-",
   "end": "-",
   "note": "POC metric over a 10-item checklist; not an industry standard."
  },
  {
   "id": "journey_reconstruction",
   "name": "Journey Reconstruction",
   "category": "Safety / quality",
   "formula": "journeys with impression, linked click, all hops and landing (if expected) / total journeys x 100",
   "start": "-",
   "end": "-",
   "note": ""
  }
 ],
